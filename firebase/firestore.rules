rules_version = '2';

// Every account lives under users/{uid} and only its owner can reach it,
// except the single admin, who can read every account and assign programs.
// Profiles prepared ahead of time live in invites/{email}.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Keep in step with AdminPolicy.email in the app.
    // Emails are compared in lower case, like the app does.
    function email() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && email() == 'ividi.dev@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function invitePath() {
      return /databases/$(database)/documents/invites/$(email());
    }

    // An owner may only set programID when it is not set yet, and only to
    // the program of the invite that matches their email.
    function takesInvitedProgram() {
      return request.auth.token.email != null
        && exists(invitePath())
        && request.resource.data.programID == get(invitePath()).data.programID;
    }

    // What an account document may hold, as written by the app.
    function validProfile(data) {
      return data.keys().hasOnly([
          'name', 'email', 'programID', 'startDate', 'reminderEnabled',
          'reminderTime', 'medicalClearance', 'updatedAt'])
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('programID' in data) || data.programID in ['standard', 'anaChallenge']);
    }

    // The email shown in the admin panel has to be the one the owner signed
    // in with.
    function ownEmail(data) {
      return !('email' in data) || data.email == email();
    }

    // One finished workout, as written by the app.
    function validSession(data) {
      return data.keys().hasOnly([
          'dayIndex', 'date', 'durationSeconds', 'lowEnergy', 'energy', 'discomfort', 'note'])
        && data.dayIndex is int && data.dayIndex >= 1 && data.dayIndex <= 28
        && data.date is number
        && (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if validProfile(request.resource.data) && (isAdmin()
        || (isOwner(uid) && ownEmail(request.resource.data)
          && (!('programID' in request.resource.data) || takesInvitedProgram())));
      allow update: if validProfile(request.resource.data) && (isAdmin()
        || (isOwner(uid) && ownEmail(request.resource.data) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['programID'])
          || (!('programID' in resource.data) && takesInvitedProgram())
        )));
      allow delete: if isOwner(uid);

      match /sessions/{sessionID} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && validSession(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    match /invites/{inviteEmail} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.token.email != null && email() == inviteEmail);
      allow write: if isAdmin();
    }
  }
}
